{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@publisher/*": [
        "./src/*"
      ],
      "@root/*": [
        "../../*"
      ]
    },
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../src/editor/runtime/**/*",
    "../../src/editor/events/**/*",
    "../../src/editor/materials/**/*",
    "../../src/editor/hooks/**/*",
    "../../src/editor/components/MaterialItem/**/*",
    "../../src/editor/registry/**/*",
    "../../src/editor/stores/**/*",
    "../../src/editor/interface.ts",
    "../../src/shared/publish/**/*",
    "../../packages/lowcode-schema/src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
