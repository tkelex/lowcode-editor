{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@publisher/*": [
        "./src/*"
      ],
      "@root/*": [
        "../../*"
      ]
    },
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../src/editor/runtime/public/**/*",
    "../../src/shared/publish/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
