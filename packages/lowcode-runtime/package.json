{
  "name": "@lowcode/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./snapshot": {
      "types": "./dist/public/snapshot.d.ts",
      "import": "./dist/public/snapshot.js",
      "default": "./dist/public/snapshot.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@lowcode/schema": "0.1.0",
    "antd": "^5.20.0",
    "axios": "^1.7.4",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.2.2"
  }
}
