{
  "name": "lowcode-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "predev": "npm run build:schema && npm run build:runtime",
    "dev": "vite",
    "dev:server": "npm run dev --workspace lowcode-editor-server",
    "predev:publisher": "npm run build:schema && npm run build:runtime",
    "dev:publisher": "npm run dev --workspace lowcode-publisher-next",
    "build:schema": "npm run build --workspace @lowcode/schema",
    "build:runtime": "npm run build --workspace @lowcode/runtime",
    "build:server": "npm run build --workspace lowcode-editor-server",
    "lint:server": "npm run lint --workspace lowcode-editor-server",
    "prisma:generate": "npm run prisma:generate --workspace lowcode-editor-server",
    "prisma:migrate": "npm run prisma:migrate --workspace lowcode-editor-server --",
    "prisma:deploy": "npm run prisma:deploy --workspace lowcode-editor-server",
    "admin:grant": "npm run admin:grant --workspace lowcode-editor-server --",
    "build": "npm run build:schema && npm run build:runtime && tsc -b && vite build",
    "prebuild:publisher": "npm run build:schema && npm run build:runtime",
    "build:publisher": "npm run build --workspace lowcode-publisher-next",
    "lint": "eslint . --max-warnings 0",
    "lint:publisher": "npm run lint --workspace lowcode-publisher-next",
    "preview": "vite preview",
    "pretest": "npm run build:server",
    "test": "node scripts/test/run-tests.mjs",
    "check:architecture": "node scripts/architecture/check-boundaries.mjs",
    "check:editor-props": "node scripts/audit/editor-prop-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:editor": "playwright test e2e/editor-regression.spec.ts",
    "smoke:api": "node scripts/smoke/api-smoke.mjs",
    "check": "npm run lint && npm run check:architecture && npm run build && npm run test",
    "start:publisher": "npm run start --workspace lowcode-publisher-next",
    "check:publisher": "npm run build:publisher",
    "preflight": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@lowcode/runtime": "0.1.0",
    "@lowcode/schema": "0.1.0",
    "@monaco-editor/react": "^4.6.0",
    "allotment": "^1.20.2",
    "axios": "^1.7.4",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "style-to-object": "^1.0.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.20.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
}
